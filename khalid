import java.util.Scanner;

public class Calculator {

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);

        System.out.println("اختر العملية: +  -  *  /");
        char operation = input.next().charAt(0);

        System.out.print("ادخل الرقم الأول: ");
        double num1 = input.nextDouble();

        System.out.print("ادخل الرقم الثاني: ");
        double num2 = input.nextDouble();

        double result;

        switch (operation) {
            case '+':
                result = num1 + num2;
                System.out.println("الناتج: " + result);
                break;
            case '-':
                result = num1 - num2;
                System.out.println("الناتج: " + result);
                break;
            case '*':
                result = num1 * num2;
                System.out.println("الناتج: " + result);
                break;
            case '/':
                if (num2 == 0) {
                    System.out.println("خطأ: لا يمكن القسمة على صفر");
                } else {
                    result = num1 / num2;
                    System.out.println("الناتج: " + result);
                }
                break;
            default:
                System.out.println("عملية غير صحيحة");
        }

        input.close();
    }
}
